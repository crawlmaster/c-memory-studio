# ==============================================================================
# C-Memory-Studio Configuration
# Copy this file to .env and adjust values as needed: cp .env.example .env
# ==============================================================================

# Host port binding for the FastAPI / Uvicorn backend service
BACKEND_PORT=8080

# Internal tmpfs workspace path (used by application worker processes)
TMPFS_PATH=/sandbox/workspace

# Maximum time (in seconds) allowed for a single compile/GDB/Valgrind run
MAX_EXECUTION_TIMEOUT=10
